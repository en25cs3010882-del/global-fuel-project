      <aliases enabled='yes' />
      <column caption='Subsidy Score:' datatype='integer' name='[Calculation_1110842668933120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [subsidy_level]&#13;&#10;WHEN &apos;Low&apos; THEN 1&#13;&#10;WHEN &apos;Medium&apos; THEN 2&#13;&#10;WHEN &apos;High&apos; THEN 3&#13;&#10;WHEN &apos;Very High&apos; THEN 4&#13;&#10;END' />
      </column>
      <column caption='Avg Fuel Price:' datatype='real' name='[Calculation_1110842669846529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([petrol_usd_liter] + [diesel_usd_liter] + [lpg_usd_liter]) / 3' />
      </column>
      <column caption='Diesel Volatility:' datatype='real' name='[Calculation_1110842670002178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([diesel_usd_liter]) / AVG([diesel_usd_liter])' />
      </column>
