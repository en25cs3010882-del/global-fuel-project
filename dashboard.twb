    <worksheet name='Diesel Price Volatility by Region and Year'>
      <table>
        <view>
          <datasources>
            <datasource caption='global_fuel_prices_Dataset' name='federated.01v6m9c1nq5ri911hi2v70rgzv48' />
          </datasources>
          <datasource-dependencies datasource='federated.01v6m9c1nq5ri911hi2v70rgzv48'>
            <column caption='Diesel Volatility:' datatype='real' name='[Calculation_1110842670002178]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='STDEV([diesel_usd_liter]) / AVG([diesel_usd_liter])' />
